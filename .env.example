# Copy to .env (never commit). Starter defaults for the hotelmanagement project.
APP_NAME=HotelManagement
MODE=development
PORT=9000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotelmanagement
API_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-an-even-longer-random-string
# Comma-separated Google OAuth client IDs (web, Android, iOS). The id_token
# audience must match one of these. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_IDS=
# Optional. Leave empty to use free built-in Tesseract OCR (works offline).
# Set for higher accuracy on menu photos via Google Cloud Vision API.
GOOGLE_VISION_API_KEY=
# Optional. TypeSafe Jev — classifies parsed items into canonical categories
# and veg/non-veg. Get a key at https://docs.typesafe.ai (System One models).
# Leave empty to use parser headings as-is.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
SMS_AUTH_TOKEN=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
